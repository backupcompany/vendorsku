# Server only. Never put this in frontend code or commit a real value.
GEMINI_API_KEY=

# Optional. The Vite dev server defaults to 3000.
PORT=3000

# Go API. The live copy is on siloamhospitals-t.
# Run `siloamhospitals-t tunnel`, then use 127.0.0.1:15432 in .env.
DATABASE_URL=postgres://localhost:5432/siloam_sku?sslmode=disable
GO_PORT=8080

# Power Automate HTTP trigger that sends email ({to,cc,bcc,subject,body,isHtml}). Server only.
MAIL_WEBHOOK_URL=
